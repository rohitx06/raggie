# ==================================================
# RAG Chatbot Platform — Server Environment Config
# ==================================================

# Express Server Port
PORT=5000

# PostgreSQL Database URL
# Example: postgresql://username:password@localhost:5432/rag_platform
# Leave empty to use local auto-persisting JSON store (zero setup needed for testing)
DATABASE_URL=

# Linode Dify API Configuration
# Your Dify instance URL (e.g. http://<YOUR_LINODE_IP_OR_DOMAIN>/v1)
DIFY_BASE_URL=http://localhost:5001/v1

# Dify API Keys (Never exposed to the frontend!)
# Dataset API Key for managing Knowledge Bases & Uploading Documents
DIFY_DATASET_API_KEY=

# Chat API Key for LLM Orchestration & Chat Completions
DIFY_CHAT_API_KEY=
